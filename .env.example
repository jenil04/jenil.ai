# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL of the deployment (used to build the x402 `resource` field).
NEXT_PUBLIC_APP_URL=https://jenil.ai

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Neon connection string. Contains a password — set it here / in Vercel, never paste in chat.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── x402 payments (Base mainnet, CDP facilitator) ────────────────────────────
# Wallet that RECEIVES all USDC payments (Jenil's wallet). Never hardcoded in code.
X402_PAYEE_WALLET=0x0000000000000000000000000000000000000000
# eip155:8453 = Base mainnet. eip155:84532 = Base Sepolia (testnet).
X402_NETWORK=eip155:8453
# CDP-managed facilitator (mainnet). For testnet use https://x402.org/facilitator
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# Coinbase CDP Developer Platform key (Ed25519). From portal.cdp.coinbase.com → API Keys.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ── Content screening (Anthropic Claude) ─────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override; defaults to a capable screening model in code.
SCREENING_MODEL=claude-sonnet-4-6

# ── X / Twitter API v2 (OAuth2 user context, write scope) ─────────────────────
# Bearer access token for the account that performs the repost.
X_API_BEARER_TOKEN=

# ── Email notifications (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
JENIL_NOTIFY_EMAIL=jenil@example.com
# Verified sender on your Resend domain.
RESEND_FROM_EMAIL=agent@jenil.ai

# ── Admin dashboard ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── Repost safety valve ───────────────────────────────────────────────────────
# false (default) = fully automated repost on screen pass.
# true = passed reposts queue for one-tap approval in /admin instead of auto-posting.
REPOST_REQUIRE_APPROVAL=false
